/*
   Lesson 4C : Non-Blocking Acceleration ramp Stepper Engine
   Features: 
   Acceleration ramp code architecture from low speed to cruise speed
   Set limit distance traveled in mm by pressing push buttons
   Non-blocking Serial Telemetry

   Author: Harwell Mejia
   Tutor: GEMINI and Open CircuitAI
   - Architecture : Dual Independent Non-Blocking Tasks
   - Driver Type  : STEP / DIR
   - Timebase     : micros() [Stepper] | millis() [Telemetry]

   Date:
   - 2026/09/10

   Hardware: 
   - 1x Arduino UNO
   - 1x Stepper NEMA 17 
   - 1x A4988 Stepper driver
   - 1x LCD 16x2 
   - 1x I2C lcd driver
   - 7x push buttons
   
   Compiled and run in Cirkit Designer
   Simulation link:
   https://app.cirkitdesigner.com/project/53498ab5-3510-4da2-ae49-b3115783d992
*/
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define dirPin 2
#define stepPin 3
#define BTN_PIN1 4
#define BTN_PIN2 5
#define BTN_PIN3 6
#define BTN_PIN4 7
#define BTN_PIN5 8
#define BTN_PIN6 9
#define BTN_PIN7 10
#define stepsPerRev 200

LiquidCrystal_I2C lcd(0x27, 16, 2);


//==Global state variables
bool isForward = true;
bool motionStart = false;
bool stepState = LOW;
bool targetReached = false;
unsigned long targetStep = 0;
unsigned long currentStep = 0;

//==GTE BLT and distance parameters
long targetDistance; //Distance in mm, tunned by toggle buttons
long countDistance = 0;

const int beltPitch = 2;
const int theetCount = 20;
unsigned int distPerRev; // How long it travel per revolution
float stepsPerDistance; //How many steps per mm

//==Motion state parameters
unsigned int Acceleration = 40;
unsigned long accelStep;
unsigned int initialSpeed = 5;
unsigned int cruiseSpeed = 120;

unsigned long initialInterval;
unsigned long cruiseInterval;

//==Non-blocking stepper==
unsigned long stepInterval;
unsigned long lastStepTime = 0;

//==Non-blocking Serial Telemetry
unsigned long lastSerialTime = 0;
const unsigned long serialInterval = 150;

//==Non-blocking LCD Refresh telemetry
unsigned long lastLCDTime = millis();
const unsigned long lcdInterval = 250;

//==Non-blocking Toggle switch parameters==
//Button 1 Addition of 100mm
bool lastBTN1Read = HIGH;
bool stableBTN1State = HIGH;
unsigned long btn1BounceTime = 0;

//Button 2 Addition of 10mm
bool lastBTN2Read = HIGH;
bool stableBTN2State = HIGH;
unsigned long btn2BounceTime = 0;

//Button 3 Addition of 1mm
bool lastBTN3Read = HIGH;
bool stableBTN3State = HIGH;
unsigned long btn3BounceTime = 0;

//Button 4 Substract 100mm
bool lastBTN4Read = HIGH;
bool stableBTN4State = HIGH;
unsigned long btn4BounceTime = 0;

//Button 5 Substract 10mm
bool lastBTN5Read = HIGH;
bool stableBTN5State = HIGH;
unsigned long btn5BounceTime = 0;

//Button 6 Substract 1mm
bool lastBTN6Read = HIGH;
bool stableBTN6State = HIGH;
unsigned long btn6BounceTime = 0;

//Button 7 Start/pause button
bool lastStartRead = HIGH;
bool stableStartState = HIGH;
unsigned long startBounceTime = 0;

const unsigned long DebounceDelay = 50;

void setup(){
    Serial.begin(115200);
    pinMode(BTN_PIN1, INPUT_PULLUP);
    pinMode(BTN_PIN2, INPUT_PULLUP);
    pinMode(BTN_PIN3, INPUT_PULLUP);
    pinMode(BTN_PIN4, INPUT_PULLUP);
    pinMode(BTN_PIN5, INPUT_PULLUP);
    pinMode(BTN_PIN6, INPUT_PULLUP);
    pinMode(BTN_PIN7, INPUT_PULLUP);
    pinMode(dirPin, OUTPUT);
    pinMode(stepPin, OUTPUT);
    lcd.begin(16,2);
    lcd.backlight();

    lcd.setCursor(0,0);
    lcd.print("Dist: 0 mm");

    //Initial state
    initialInterval = 60000000UL / (initialSpeed * stepsPerRev * 2UL);
    cruiseInterval = 60000000UL / (cruiseSpeed * stepsPerRev * 2UL);
    stepInterval = initialInterval;

    accelStep = (initialInterval - cruiseInterval) / Acceleration;

    digitalWrite(dirPin, HIGH);
    digitalWrite(stepPin, LOW);

    lastStepTime = micros();
    lastSerialTime = millis();

    //Belt motion calculation
    distPerRev = (float) (beltPitch * theetCount);           // 2mm * 20/Rev = 40 mm/Rev
    stepsPerDistance = (float)stepsPerRev / (float)distPerRev;  // 200 steps/Rev / 40mm/Rev = 5 steps/mm

    //Telemetry
    Serial.println("\nWelcome to Arduino - State Machine **Stepper** Series");
    Serial.println("By Harwell Mejia");

    Serial.println("RPM  |  Distance  |  Steps ");
    lcd.setCursor(0,0);
    lcd.print("Set: 0.00 mm");
    lcd.print("            ");
}

void loop(){
    //=============================================
    //== TASK 1 - Initiate toggle buttons
    //=============================================
    //1.1 Add 100mm
    //1.1.1 Reading electrical signal
    bool currentBTN1Read = digitalRead(BTN_PIN1);
    //1.1.2 Detecting electrical change
    if(currentBTN1Read != lastBTN1Read){
        lastBTN1Read = currentBTN1Read;
        btn1BounceTime = millis();
    }
    //1.1.3 Check bounce time
    unsigned long currentBTN1Time = millis();
    if(currentBTN1Time - btn1BounceTime >= DebounceDelay){
        bool verifiedBTN1Read = digitalRead(BTN_PIN1);
        //1.1.4 Check stable state
        if(verifiedBTN1Read != stableBTN1State){
            stableBTN1State = verifiedBTN1Read;
            //1.1.5 Valid button pressing
            if(stableBTN1State == LOW){
                countDistance += 100;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm     ");
                lcd.print("             ");
            }
        }
    }
    //=============================================
    //1.2 Button 2 - ADD 10mm
    //1.2.1 Reading electrical signal
    bool currentBTN2Read = digitalRead(BTN_PIN2);
    //1.2.2 Detecting electrical change
    if(currentBTN2Read != lastBTN2Read){
        lastBTN2Read = currentBTN2Read;
        btn2BounceTime = millis();
    }
    //1.1.3 Check bounce time
    unsigned long currentBTN2Time = millis();
    if(currentBTN2Time - btn2BounceTime >= DebounceDelay){
        bool verifiedBTN2Read = digitalRead(BTN_PIN2);
        //1.1.4 Check stable state
        if(verifiedBTN2Read != stableBTN2State){
            stableBTN2State = verifiedBTN2Read;
            //1.1.5 Valid button pressing
            if(stableBTN2State == LOW){
                countDistance += 10;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm     ");
                lcd.print("             ");
            }
        }
    }
    //=====================================================
    //1.3 Button 3 - Add 1mm
    //1.3.1
    bool currentBTN3Read = digitalRead(BTN_PIN3);
    //1.3.2
    if(currentBTN3Read != lastBTN3Read){
        lastBTN3Read = currentBTN3Read;
        btn3BounceTime = millis();
    }
    //1.3.3
    unsigned long currentBTN3Time = millis();
    if(currentBTN3Time - btn3BounceTime >= DebounceDelay){
        bool verifiedBTN3Read = digitalRead(BTN_PIN3);
        //1.3.4
        if(verifiedBTN3Read != stableBTN3State){
            stableBTN3State = verifiedBTN3Read;
            //1.3.5
            if(stableBTN3State == LOW){
                countDistance++;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm");
                lcd.print("             ");
            }
        }
    }
    // ================================================
    //1.4 Button 4 - Substract 100 mm
    //1.4.1
    bool currentBTN4Read = digitalRead(BTN_PIN4);
    //1.4.2
    if(currentBTN4Read != lastBTN4Read){
        lastBTN4Read = currentBTN4Read;
        btn4BounceTime = millis();
    }
    //1.4.3
    unsigned long currentBTN4Time = millis();
    if(currentBTN4Time - btn4BounceTime >= DebounceDelay){
        bool verifiedBTN4Read = digitalRead(BTN_PIN4);
        //1.4.4
        if(verifiedBTN4Read != stableBTN4State){
            stableBTN4State = verifiedBTN4Read;
            //1.4.5
            if(stableBTN4State == LOW){
                countDistance -= 100;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm");
                lcd.print("             ");
            }
        }
    }
    // ================================================
    //1.5 Button 5 - Substract 10 mm
    //1.5.1
    bool currentBTN5Read = digitalRead(BTN_PIN5);
    //1.5.2
    if(currentBTN5Read != lastBTN5Read){
        lastBTN5Read = currentBTN5Read;
        btn5BounceTime = millis();
    }
    //1.5.3
    unsigned long currentBTN5Time = millis();
    if(currentBTN5Time - btn5BounceTime >= DebounceDelay){
        bool verifiedBTN5Read = digitalRead(BTN_PIN5);
        //1.5.4
        if(verifiedBTN5Read != stableBTN5State){
            stableBTN5State = verifiedBTN5Read;
            //1.5.5
            if(stableBTN5State == LOW){
                countDistance -= 10;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm");
                lcd.print("             ");
            }
        }
    }
    //=============================================
    //1.6 Button 6 - Substract 1
    //1.6.1
    bool currentBTN6Read = digitalRead(BTN_PIN6);
    //1.6.2
    if(currentBTN6Read != lastBTN6Read){
        lastBTN6Read = currentBTN6Read;
        btn6BounceTime = millis();
    }
    //1.6.3
    unsigned long currentBTN6Time = millis();
    if(currentBTN6Time - btn6BounceTime >= DebounceDelay){
        bool verifiedBTN6Read = digitalRead(BTN_PIN6);
        //1.6.4
        if(verifiedBTN6Read != stableBTN6State){
            stableBTN6State = verifiedBTN6Read;
            //1.6.5
            if(stableBTN6State == LOW){
                countDistance -= 1;
                lcd.setCursor(0,0);
                lcd.print("Set: ");
                lcd.print(countDistance);
                lcd.print(" mm ");
                lcd.print("              ");
            }
        }
    }
    //=============================================
    //Start / stop button
    //=============================================
    //1.7 Start button
    //1.7.1 
    unsigned long currentStartRead = digitalRead(BTN_PIN7);
    //1.7.2
    if(currentStartRead != lastStartRead){
        lastStartRead = currentStartRead;
        startBounceTime = millis();
    }
    //1.7.3
    unsigned long currentStartTime = millis();
    if(currentStartTime - startBounceTime >= DebounceDelay){
        bool verifiedStartRead = digitalRead(BTN_PIN7);

        //1.7.4
        if(verifiedStartRead != stableStartState){
            stableStartState = verifiedStartRead;
            //1.7.5
            if(stableStartState == LOW){
                motionStart = !motionStart;

                //Prepare motion data when start is pressed
                if(motionStart){
                    if(countDistance > 0){
                        isForward = true;
                    }
                    else{
                        isForward = false;
                    }
                    targetDistance = countDistance;
                    targetStep = (unsigned long) (abs((float)targetDistance * stepsPerDistance));

                    //Safety guard
                    unsigned long calcAccel = (initialInterval - cruiseInterval) / Acceleration;
                    accelStep = (calcAccel > targetStep)? targetStep:calcAccel;

                    //Reset execution state
                    currentStep = 0;
                    stepInterval = initialInterval;
                    targetReached = false;
                    lastStepTime = micros();
                }
            }
        }
    }
    //=============================================

    //=============================================

    //== TASK 2 - Stepper motion ==
    if(motionStart){
          
        //2.1 Motion limits guard
        if(currentStep >= targetStep){
            stepState = LOW;
            digitalWrite(stepPin, stepState);
            //Printing target reached
            if(!targetReached){
                Serial.print("---> Target ** ");
                Serial.print(targetDistance);
                Serial.println(" mm ** Reached <---");
                 float currentDistance = (float) (currentStep / stepsPerDistance);
                 
                lcd.setCursor(0,1);
                lcd.print("Dist: ");
                lcd.print(currentDistance);
                lcd.print(" mm");
                lcd.print("            ");

                targetReached = true;
            }
            return;
        }
        //2.2 Non-blocking stepper motion
        unsigned long currentStepTime = micros();
        if(currentStepTime - lastStepTime >= stepInterval){
            lastStepTime += stepInterval;
            stepState = !stepState;
            digitalWrite(stepPin, stepState? HIGH:LOW);
            digitalWrite(dirPin, isForward? HIGH:LOW);
            
            //Counting steps
            if(stepState == HIGH){
                currentStep++;
                //Acceleration ramp
                if(currentStep < accelStep){
                    if(stepInterval > cruiseInterval + Acceleration){
                        stepInterval -= Acceleration;
                    }
                    else{
                        stepInterval = cruiseInterval;
                    }
                }
                //Cruise speed
                else if(currentStep >= accelStep){
                    stepInterval = cruiseInterval;
                }
            }
        }
        //==Task 2.3 - Non-blocking Serial Telemetry
        unsigned long currentSerialTime = millis();
        if(currentSerialTime - lastSerialTime >= serialInterval){
            lastSerialTime += serialInterval;
            float currentSpeed = 60000000.0f / ((float)stepInterval * stepsPerRev * 2.0f);
            float currentDistance = (float) (currentStep / stepsPerDistance);
            Serial.print(currentSpeed, 2);
            Serial.print("  |  ");
            Serial.print(currentDistance);
            Serial.print("  |  ");
            Serial.println(currentStep);
        }

        //==Task 2.4 Non-blocking LCD Refresh telemetry
        unsigned long currentLCDTime = millis();
        if(currentLCDTime - lastLCDTime >= lcdInterval){
            lastLCDTime += lcdInterval;

            float currentDistance = (float) (currentStep / stepsPerDistance);
            lcd.setCursor(0,1);
            lcd.print("Dist: ");
            lcd.print(currentDistance);
        }
    }
}
