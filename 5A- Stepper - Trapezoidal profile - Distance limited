/*
   Lesson 5 : Stepper - Trapezoidal Speed profile **Core code Structure**
   Features: 
   Non-blocking acceleration-> Cruise Speed -> Deceleration ramp (Trapezoidal Speed profile)
   Triangle speed profile as Safe guard for short distances traveled
   Distance limited in mm, the software convert it in STEPS 
   Non-blocking Serial Telemetry
   Non-blocking LCD refresh telemetry

   Author: Harwell Mejia
   Tutor: GEMINI
   - Architecture : Dual Independent Non-Blocking Tasks
   - Driver Type  : STEP / DIR
   - Timebase     : micros() [Stepper] | millis() [Telemetry]

   Date:
   - 2026/09/15

   Hardware: 
   - 1x Arduino UNO
   - 1x Stepper NEMA 17 
   - 1x A4988 Stepper driver
   - 1x LCD 16x2
   - 1x I2C driver
   
   Compiled and run in Cirkit Designer
*/
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define dirPin 2
#define stepPin 3
#define stepsPerRev 200

LiquidCrystal_I2C lcd(0x27, 16, 2);

//== Global Motion state ==
bool stepState = false;
bool isForward = true; //Forward -> clockwise direction
bool motionComplete = false;
bool systemState = false;

unsigned long targetSteps;
unsigned long currentStep = 0; //Steps counter

//GT2 Belt parameters
const int beltPitch = 2; //in mm
const int theetNumber = 20; // theet per Rev
float distancePerRev; // Pitch * Theet [mm/Rev]
float stepDistance; // stepsPerRev / distancePerRev [steps/mm]

//**DISTANCE VARIABLE** CHANGE DISTANCE  HERE -->>
float targetDistance = -1000; //Total Distance traveled = stepsPerRev / stepDistace [mm]


//== Stepper motion variable ==
const int Acceleration = 30;
unsigned long accelStep;
unsigned long decelStep;
const unsigned long initialSpeed = 5; //all speeds in RPM
const unsigned long cruiseSpeed = 120;
unsigned long initialInterval; //stepper interval, all in [uS/Steps]
unsigned long cruiseInterval;

//== Non-blocking Stepper parameters==
unsigned long lastStepTime = 0;
unsigned long stepInterval;

//== Non-blocking Serial telemetry
unsigned long lastSerialTime = 0;
const unsigned long serialInterval = 150;

//== Non-blocking LCD refresh telemetry
unsigned long lastLCDTime = 0;
const unsigned long lcdInterval = 200;

void setup(){
    Serial.begin(115200);
    pinMode(dirPin, OUTPUT);
    pinMode(stepPin, OUTPUT);
    lcd.begin(16,2);
    lcd.backlight();

    //Initial state
    distancePerRev = beltPitch * theetNumber ; // Pitch * Theet [mm/Rev]
    stepDistance = (float) stepsPerRev / distancePerRev; // stepsPerRev / distancePerRev [steps/mm]
    //**targetSteps must be positive, thus targetDistance must be absolute (abs)**
    targetSteps = (unsigned long) (stepDistance * abs(targetDistance)); //Total Distance traveled = stepsPerRev / stepDistance [mm]

    initialInterval = 60000000UL / (stepsPerRev * initialSpeed * 2UL);
    cruiseInterval = 60000000UL / (stepsPerRev * cruiseSpeed * 2UL);
    stepInterval = initialInterval;
    //Acceleration-deceleration ramp distance
    accelStep = (initialInterval - cruiseInterval) / Acceleration;
    decelStep = targetSteps - accelStep;

    //Initiate timer
    lastStepTime = micros();
    lastLCDTime = millis();
    lastSerialTime = millis();

    digitalWrite(dirPin, HIGH); // Start in clockwise direction
    digitalWrite(stepPin, LOW); // Initially off

    //Safe guards Triangle shape profile for Short distance
    if(accelStep >= targetSteps){
        accelStep = targetSteps / 2.;
        decelStep = accelStep;
    }

    //Set direction depending on the distance
    if(targetDistance >= 0){
        isForward = true;
        digitalWrite(dirPin, isForward);
    }
    else{
        isForward = false;
        digitalWrite(dirPin, isForward);
    }

    //Telemetry
    Serial.println("\nWelcome to Arduino - State Machine **Stepper** Series");
    Serial.println("Trapezoidal Speed Profile");
    Serial.println("By Harwell Mejia");
    Serial.print("Max Distance: ");
    Serial.print(targetDistance);
    Serial.print(" | Max steps: ");
    Serial.println(targetSteps);
    Serial.println("RPM  | Steps  |  Revs  |   Distance  ");

    lcd.setCursor(0,0);
    lcd.print("Dist: 0 mm");;
    lcd.setCursor(0,1);
    lcd.print("RPM: 0 ");
}
void loop(){
    // Stop when reach the maximum distance
    if(currentStep >= targetSteps){
        stepState = false;
        digitalWrite(stepPin, stepState);

        //Telemetry stop printing when reach maximum distance
        if(!motionComplete){
            Serial.print("Target distance ** ");
            Serial.print(targetDistance);
            Serial.println(" mm** reached");

            lcd.setCursor(0,0);
            lcd.print("Dist: ");
            lcd.print(targetDistance);
            lcd.print(" mm");
            motionComplete = true;
        }
        return;
    }

    //Stepper motion
    unsigned long currentStepTime = micros();
    //-Non-blocking steppper timer
    if(currentStepTime - lastStepTime >= stepInterval){
        lastStepTime += stepInterval;
        stepState = !stepState;
        digitalWrite(stepPin, stepState? HIGH:LOW);

        //Counting steps in HIGH Pulse
        if(stepState == HIGH){
            currentStep++;

            //Trapezoidal Profile start HERE-->
            //Acceleration stage
            if(currentStep < accelStep){
                //Safe guard for very slow speed
                if(stepInterval > cruiseInterval){
                    stepInterval -= Acceleration;
                }
                else{
                    stepInterval = cruiseInterval;
                }
            }
            //Cruise speed Stage
            else if(currentStep >= accelStep && currentStep < decelStep){
                stepInterval = cruiseInterval;
            }
            //Decelaration Stage
            else if(currentStep >= decelStep){
                stepInterval += Acceleration;
            }
        }
    }

    //Non- blocking Serial Telemetry
    unsigned long currentSerialTime = millis();
    if(currentSerialTime - lastSerialTime >= serialInterval){
        lastSerialTime += serialInterval;

        float currentSpeed = 60000000.0 / ((float)stepInterval * stepsPerRev * 2.0f);
        float currentRev = (float)currentStep / stepsPerRev;
        float currentDistance = currentStep / stepDistance;
        Serial.print(currentSpeed,2);
        Serial.print("  |  ");
        Serial.print(currentStep);
        Serial.print("  |  ");
        Serial.print(currentRev,2);
        Serial.print("  |  ");
        Serial.println(currentDistance,2);
    }

    //Non-blocking LCD Telemetry
    unsigned long currentLCDTime = millis();
    if(currentLCDTime - lastLCDTime >= lcdInterval){
        lastLCDTime += lcdInterval;
        float currentSpeed = 60000000.0 / ((float)stepInterval * stepsPerRev * 2.0f);
        float currentDistance = currentStep / stepDistance;
        lcd.setCursor(0,0);
        lcd.print("Dist: ");
        lcd.print(currentDistance,2);
        lcd.print(" mm");
        lcd.print("              ");
        lcd.setCursor(0,1);
        lcd.print("RPM: ");
        lcd.print(currentSpeed,2);
        lcd.print("              ");      
    }
}
