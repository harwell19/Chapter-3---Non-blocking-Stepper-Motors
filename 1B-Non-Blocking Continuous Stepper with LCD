/*
   Lesson 1b : Non-Blocking Continuous Stepper Engine
   Basic stepper code architecture to a constant-infinite speed
   LCD added to display revs information

   Author: Harwell Mejia
   Tutor: GEMINI
   - Architecture : Dual Independent Non-Blocking Tasks
   - Driver Type  : STEP / DIR
   - Timebase     : micros() [Stepper] | millis() [Telemetry]
   Hardware: 
   - Arduino UNO
   - Stepper NEMA 17 
   - A4988 Stepper driver
   - LCD 16x2 + I2C driver
   Compiled and run in WOKWI
*/
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define dirPin 2
#define stepPin 3
#define stepsPerRev 200

LiquidCrystal_I2C lcd(0x27, 16,2);

//== Global state variable
bool stepState = LOW;
const unsigned int rpm = 60;
unsigned long totalSteps = 0;

//== Non-blocking timers ==
unsigned long lastStepTime = 0;
unsigned long stepInterval; // To be calculated

unsigned long lastSerialTime =0;
const unsigned long serialInterval = 250;

unsigned long lastLCDTime = 0;
const unsigned long lcdInterval = 250;

void setup(){
  Serial.begin(115200);
  pinMode(dirPin, OUTPUT);
  pinMode(stepPin, OUTPUT);
  lcd.begin(16,2);
  lcd.backlight();

  //Starting mode
  stepInterval = 60000000UL/ (rpm * stepsPerRev * 2.);

  digitalWrite(dirPin, HIGH);
  digitalWrite(stepPin, LOW);
  
  lastStepTime = micros();
  lastSerialTime = millis();
  lastLCDTime = millis();

  //Telemetry
  Serial.println("\nWelcome to Arduino - State machines");
  Serial.println("By: Harwell Mejia");
  Serial.print("RPM: ");
  Serial.print(rpm);
  Serial.print("  |  Half-interval pulse: ");
  Serial.println(stepInterval);
}

void loop(){
  //==Task 1 - Non-blocking stepper timer ==
  unsigned long currentStepTime = micros();
  if(currentStepTime - lastStepTime >= stepInterval){
    lastStepTime += stepInterval;

    stepState = !stepState;
    digitalWrite(stepPin, stepState);
    
    // Counting steps
    if(stepState == HIGH){
      totalSteps++;
    }
  }

  //==Task 2 - Non-blocking Serial Telemetry
  unsigned long currentSerialTime = millis();
  if(currentSerialTime - lastSerialTime >= serialInterval){
    lastSerialTime += serialInterval;

    //Calculating number of revolution in real time
    float totalRev = (float)totalSteps / stepsPerRev;
    Serial.print("Revolutions: ");
    Serial.print(totalRev);
    Serial.print(" | ");
    Serial.print("Steps: ");
    Serial.println(totalSteps);
  }

  //==Task 3- Non-blocking LCD refresh telemetry
  unsigned long currentLCDTime = millis();
  if(currentLCDTime - lastLCDTime >= lcdInterval){
    lastLCDTime += lcdInterval;

    //Calculating number of revolution in real time
    float totalRev = (float)totalSteps / stepsPerRev;
    lcd.setCursor(0,0);
    lcd.print("Revs: ");
    lcd.print(totalRev);
    lcd.print("          ");
    
    lcd.setCursor(0,1);
    lcd.print("Steps: ");
    lcd.print(totalSteps);
    lcd.print("          ");
  }
}
